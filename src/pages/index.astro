---
import ActivitySection from "@/components/activity/ActivitySection.astro";
import Contact from "@/components/home/Contact.astro";
import FeaturedWork from "@/components/home/FeaturedWork.astro";
import Hero from "@/components/home/Hero.astro";
import Journey from "@/components/home/Journey.astro";
import Marquee from "@/components/home/Marquee.astro";
import { HeroBio, RecentNews } from "@/components/sections/HeroBio";
import ProfileSidebar from "@/components/sections/ProfileSidebar";
import { SectionHeader } from "@/components/ui/SectionHeader";
import Layout from "@/layouts/Layout.astro";
import { readSiteJson } from "@/utils/json-data";

const about = await readSiteJson("about.json");
const news = await readSiteJson("news.json");
---

<Layout name={about.name}>
  <Hero />
  <Marquee />
  <FeaturedWork />
  <section class="mb-20 grid grid-cols-1 gap-[clamp(28px,5vw,56px)] lg:grid-cols-[240px_1fr]">
    <ProfileSidebar about={about} />
    <div>
      <HeroBio about={about} />
      <RecentNews news={news} />
    </div>
  </section>
  <Journey />
  <section class="mb-20">
    <SectionHeader title="Activity" />
    <ActivitySection />
  </section>
  <Contact />
</Layout>
