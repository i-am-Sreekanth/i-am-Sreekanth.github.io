---
import Layout from "@/layouts/Layout.astro";
import SimpleLayout from "@/components/layout/SimpleLayout";
import ListCourses from "@/components/courses/ListCourses";
import { readSiteJson } from "@/utils/json-data";

const courses = await readSiteJson<Course[]>("courses.json");
---

<Layout
  title="Courses"
  description="Courses and certifications I've taken, covering the maths, computer science and AI foundations behind my work."
  canonicalPath="/courses"
>
  <SimpleLayout
    eyebrow="Learning"
    title="Courses"
    intro="University courses and certifications that shaped how I build software and machine learning systems."
  >
    <div class="mt-8">
      <ListCourses courses={courses} />
    </div>
  </SimpleLayout>
</Layout>
