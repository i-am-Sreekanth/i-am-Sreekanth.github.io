---
const navigations = [
  { href: "/", label: "Home" },
  { href: "/about", label: "Me" },
  { href: "/projects", label: "Projects" },
  { href: "/cv", label: "CV" },
  { href: "/courses", label: "Courses" },
];

const raw = Astro.url.pathname.replace(/\/$/, "").replace(/\/index\.html$/i, "") || "/";

function isActive(href: string) {
  return raw === href || (href !== "/" && raw.startsWith(href));
}
---

<header id="site-header" class="sticky top-0 z-40" style="transition:none">
  <div class="bg-bg/80 border-rule border-b backdrop-blur-[14px] backdrop-saturate-[180%]">
    <div class="mx-auto grid max-w-[1100px] grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 px-[clamp(20px,4vw,36px)] py-[14px]">
      {/* Brand */}
      <a href="/" class="inline-flex items-center justify-self-start hover:no-underline">
        <picture>
          <img
            src="/images/me.jpeg"
            alt="Sreekanth Radhakrishnan"
            width="34"
            height="34"
            class="ring-rule h-[34px] w-[34px] rounded-full object-cover shadow-xs ring-1"
          />
        </picture>
      </a>

      {/* Desktop nav pill */}
      <div class="flex items-center justify-self-center">
        <nav class="border-rule bg-bg/70 backdrop-blur-md hidden items-center gap-[2px] rounded-full border p-[5px_6px] shadow-xs lg:flex">
          {navigations.map((l) => (
            <a
              href={l.href}
              class={`rounded-full px-[13px] py-[6px] text-[13px] font-medium whitespace-nowrap transition-colors ${
                isActive(l.href)
                  ? "text-link bg-accent-soft"
                  : "text-ink-2 hover:text-ink hover:bg-bg-2"
              }`}
            >
              {l.label}
            </a>
          ))}
        </nav>

        {/* Mobile tools */}
        <div class="flex items-center gap-1 lg:hidden">
          <button
            id="theme-btn"
            type="button"
            aria-label="Toggle dark mode"
            class="text-ink-3 hover:bg-bg-2 hover:text-ink hover:border-rule inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-[8px] border border-transparent bg-transparent transition-all duration-150"
          >
            <svg
              class="hidden h-[16px] w-[16px] dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg
              class="block h-[16px] w-[16px] dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>

      {/* Desktop tools */}
      <div class="flex items-center justify-end gap-1 justify-self-end">
        <div class="hidden items-center gap-1 lg:flex">
          <button
            id="theme-btn-desktop"
            type="button"
            aria-label="Toggle dark mode"
            class="text-ink-3 hover:bg-bg-2 hover:text-ink hover:border-rule inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-[8px] border border-transparent bg-transparent transition-all duration-150"
          >
            <svg
              class="hidden h-[16px] w-[16px] dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg
              class="block h-[16px] w-[16px] dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>

        {/* Mobile nav hamburger */}
        <div class="lg:hidden">
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-haspopup="dialog"
            class="text-ink-3 hover:bg-bg-2 hover:text-ink hover:border-rule inline-flex h-[34px] w-[34px] cursor-pointer items-center justify-center rounded-[8px] border border-transparent bg-transparent transition-all duration-150"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

{/* Mobile nav overlay */}
<button
  id="mobile-overlay"
  type="button"
  aria-label="Close menu overlay"
  class="fixed inset-0 z-50 hidden bg-zinc-800/40 backdrop-blur-xs transition-opacity"
></button>
<div
  id="mobile-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-nav-heading"
  class="fixed inset-x-4 top-8 z-50 hidden origin-top rounded-3xl bg-white p-8 ring-1 ring-zinc-900/5 dark:bg-zinc-900 dark:ring-zinc-800"
>
  <div class="flex flex-row-reverse items-center justify-between">
    <button
      id="mobile-close-btn"
      type="button"
      aria-label="Close menu"
      class="flex h-8 w-8 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-800"
    >
      <svg
        viewBox="0 0 24 24"
        width="14"
        height="14"
        stroke="currentColor"
        stroke-width="2.5"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <h2 id="mobile-nav-heading" class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
      Navigation
    </h2>
  </div>
  <nav class="mt-6">
    <ul class="divide-y divide-zinc-100 text-base text-zinc-800 dark:divide-zinc-800 dark:text-zinc-300">
      {navigations.map((l) => (
        <li>
          <a href={l.href} class="block py-2">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  // ── Scroll hide/show ────────────────────────────────────────────────────────
  const header = document.getElementById("site-header")!;
  let lastY = 0,
    ticking = false;

  // Defer adding transition so it doesn't fire on initial render
  requestAnimationFrame(() => {
    header.style.transition = "transform 1s ease-in-out";
  });

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y < 50) {
          header.style.transform = "translateY(0)";
        } else if (y > lastY + 5) {
          header.style.transform = "translateY(-100%)";
        } else if (y < lastY - 5) {
          header.style.transform = "translateY(0)";
        }
        lastY = y;
        ticking = false;
      });
    },
    { passive: true },
  );

  // ── Theme toggle ────────────────────────────────────────────────────────────
  function toggleTheme() {
    const isDark = document.documentElement.classList.contains("dark");
    // Suppress transitions briefly
    document.documentElement.classList.add("**:transition-none!");
    window.setTimeout(() => document.documentElement.classList.remove("**:transition-none!"), 0);
    const next = !isDark;
    try {
      localStorage.setItem("theme", next ? "dark" : "light");
    } catch {
      /* localStorage unavailable */
    }
    document.documentElement.classList.toggle("dark", next);
    window.dispatchEvent(new Event("colorschemechange"));
  }
  document.getElementById("theme-btn")?.addEventListener("click", toggleTheme);
  document.getElementById("theme-btn-desktop")?.addEventListener("click", toggleTheme);

  // ── Mobile nav ──────────────────────────────────────────────────────────────
  const menuBtn = document.getElementById("mobile-menu-btn")!;
  const overlay = document.getElementById("mobile-overlay")!;
  const dialog = document.getElementById("mobile-dialog")!;
  const closeBtn = document.getElementById("mobile-close-btn")!;

  function openMenu() {
    overlay.classList.remove("hidden");
    dialog.classList.remove("hidden");
    menuBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }
  function closeMenu() {
    overlay.classList.add("hidden");
    dialog.classList.add("hidden");
    menuBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  menuBtn.addEventListener("click", openMenu);
  overlay.addEventListener("click", closeMenu);
  closeBtn.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
